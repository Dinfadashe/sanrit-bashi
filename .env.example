# ------------------------------------------------------------
# SANRIT BASHI — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is already in .gitignore.
# ------------------------------------------------------------

# Supabase project settings — Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses RLS. Never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="SANRIT BASHI <noreply@yourdomain.com>"

# Dojah — dojah.io — NIN/BVN identity verification (KYC).
# Get these from your Dojah dashboard: Settings > API Keys.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# "sandbox" (free; only answers Dojah's public test NIN/BVN values) or "live"
# (real lookups, billed per call).
#
# PRODUCTION REQUIRES "live". In production the app refuses to verify
# anything unless live Dojah is configured — sandbox and the built-in mock
# approve made-up identities, so they must never face real borrowers.
DOJAH_ENV=sandbox
# Escape hatch for TESTING a production deployment with sandbox keys or the
# mock provider. Leave unset (or false) for real use.
# KYC_ALLOW_TEST_MODE=true

# Paystack — paystack.com — loan repayment collection.
# Get this from your Paystack dashboard: Settings > API Keys & Webhooks.
# Use your TEST secret key (sk_test_...) until you're ready to go live
# (sk_live_...). The same key is used both to start a payment and to verify
# the webhook that confirms it succeeded.
PAYSTACK_SECRET_KEY=

# Cron secret — protects /api/cron/accrue-late-fees from being triggered by
# anyone who just hits the URL. Set this to a random string (16+ characters)
# in both .env.local and your Vercel project's environment variables — the
# same value in both places. Vercel automatically sends it as a Bearer token
# on every scheduled invocation (see vercel.json).
CRON_SECRET=

# Public site URL, used to build links in emails (password reset, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
